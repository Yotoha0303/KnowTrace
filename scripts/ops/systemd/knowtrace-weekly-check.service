[Unit]
Description=KnowTrace 每周运维只读巡检 (weekly-check)
# systemd 的 Documentation= 只接受「可打印 ASCII 的 URI」：写原始中文路径会被判为
# "Invalid URL, ignoring" 并整条丢弃（实测 systemd 255）。百分号编码才是有效写法。
Documentation=file:///opt/knowtrace-ops/%E8%BF%90%E7%BB%B4%E8%84%9A%E6%9C%AC%E4%BD%BF%E7%94%A8%E8%AF%B4%E6%98%8E.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/knowtrace-ops
Environment=OPS_CONF=/etc/knowtrace/ops.conf
ExecStart=/usr/bin/bash /opt/knowtrace-ops/scripts/weekly-check.sh --quiet --record --json /var/lib/knowtrace/reports/ --markdown /var/lib/knowtrace/reports/
SuccessExitStatus=0 1 2

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/knowtrace /var/log/knowtrace-logs

[Install]
WantedBy=multi-user.target
