POSTGRES_HOST_PORT=15432
DATABASE_URL=postgres://knowtrace:knowtrace@localhost:15432/knowtrace

# Optional: reuse go-user-system for login. Keep false until that service is ready.
AUTH_ENABLED=false
AUTH_SERVICE_URL=http://localhost:8082
AUTH_DOCKER_SERVICE_URL=http://host.docker.internal:8082
# Only expose registration when the upstream go-user-system route is enabled.
AUTH_REGISTRATION_ENABLED=false
AUTH_COOKIE_SECURE=false

# mock works without an API key and is the default for local development.
AI_DEFAULT_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_INPUT_CHARS=12000
AI_RUNNING_STALE_AFTER_MS=300000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
