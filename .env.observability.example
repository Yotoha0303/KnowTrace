# Copy to .env.observability with mode 600. The init script generates the two
# required local secrets and leaves outbound email disabled by default.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
METRICS_BEARER_TOKEN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ALERTMANAGER_PORT=9093
# 2026-10-03：ELK（9200/5601）已被 PLG 栈（Loki + Alloy）替换，故删去那两个端口。
# Loki 只被同网络的 Grafana/Alloy 访问，3300 不发布到宿主机；
# 只有 3100 绑回环供 verify 脚本探活。
LOKI_PORT=3100
# 原 Logstash 的 TCP 入口 → 现为 Alloy 的 Loki push 入口（**协议变了**：
# NDJSON → Loki push JSON，见 deploy/alloy/config.alloy 与 verify 脚本）
ALLOY_PUSH_PORT=5000

# SMTP values are rendered into runtime/alertmanager/alertmanager.json, which
# is ignored by Git. Prefer port 587 with STARTTLS and an app-specific password.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_SMARTHOST=smtp.example.com:587
ALERT_SMTP_FROM=alerts@example.com
ALERT_SMTP_AUTH_USERNAME=alerts@example.com
ALERT_SMTP_AUTH_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
ALERT_EMAIL_TO=operator@example.com
