// Alloy 采集配置 —— 2026-10-03 替代 Logstash
//
// 采集来源与原先 Logstash 的 pipeline **一一对应**（防止换栈时漏掉某一路）：
//   Logstash input                      → Alloy 组件
//   ─────────────────────────────────────────────────────────────
//   /var/log/caddy/knowtrace-access.log → loki.source.file "caddy"
//   /var/log/nginx/knowtrace.access.log → loki.source.file "nginx"
//   /var/log/nginx/knowtrace.error.log  → 同上（同一 glob）
//   /var/lib/docker/containers/*/*.log  → loki.source.docker "containers"
//   TCP :5000（供外部投递）              → loki.source.api（原样保留）
//
// ⚠️ 最容易漏的是**容器日志**那一路：ELK 原来收全部容器日志，
//    漏掉后表现为"容器起来了、Grafana 里日志是空的"。

logging {
  level  = "warn"
  format = "logfmt"
}

// ── 宿主机文件日志：Caddy 与 Nginx ─────────────────────────────────
//
// ⚠️ 必须先用 local.file_match 做**文件发现**，再交给 loki.source.file tail。
//    另：`alloy fmt` **只查语法、不查组件属性名** —— 实测 fmt 通过但启动时
//    报 unrecognized attribute；真正的校验是启动后读日志。
//    2026-10-03 实测踩到：`loki.source.file` **不做 glob 展开** ——
//    直接写 `__path__ = "/var/log/caddy/*.log"` 时，Alloy 会把 `*` 当普通字符去 stat：
//        stat /var/log/caddy/*.log: no such file or directory
//    而文件其实存在（容器内 ls 可见）。表现为 Caddy/Nginx 日志一条都进不来，
//    但容器日志那一路正常 —— 很容易误以为"日志栈是好的"。
local.file_match "caddy" {
  path_targets = [{
    __path__ = "/var/log/caddy/*.log",
    job      = "caddy",
  }]
  // 重新执行 glob 的间隔。新机器上日志文件可能晚于 Alloy 出现
  //（实测 Caddy 日志 09:03 才生成，而 Alloy 09:01 启动），
  // 靠它会话轮询发现新文件，而不是启动时放弃。
  sync_period = "10s"
}

local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/knowtrace.*.log",
    job      = "nginx",
  }]
  sync_period = "10s"
}

loki.source.file "caddy" {
  targets    = local.file_match.caddy.targets
  forward_to = [loki.write.local.receiver]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.local.receiver]
}

// ── 容器日志：与 Logstash 的 /var/lib/docker/containers 等价 ────────
// 用 docker 服务发现而非文件 glob —— 这样每条日志自带 container_name / compose
// 服务名等标签，Grafana 里可以直接按容器筛，比解析 json-file 路径可靠。
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
}

// ── 外部投递入口（原 Logstash 的 tcp :5000）────────────────────────
// 保留这个入口是为了不改变既有调用方（脚本/外部程序把 JSON 行推进来）。
loki.source.api "push" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 5000
  }
  forward_to = [loki.write.local.receiver]
  labels     = { job = "external" }
}

// ── 出口 ────────────────────────────────────────────────────────────
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
