[Unit]
Description=KnowTrace-Workflow offsite encrypted backup upload
Documentation=file:/opt/knowtrace/docs/15-stage2-vps-reliability.md
# ⚠ 刻意**不用** Requires=/Wants= 拉入 knowtrace-workflow-backup.service。
# Requires= 的语义是「连带启动」：写上去以后，每次启动本单元都会把 backup 服务
# 也拉起来跑一轮 —— 而 backup-all.sh 在 QUIESCE_WRITES=1 下会
# `docker compose stop app auth` 静默取快照再拉起，实测造成 app 约 24 秒、
# auth 约 13 秒的计划外停机。04:10 再跑一次备份 = 每天多一次停机，且毫无必要。
#
# 本单元只上传 /var/backups/knowtrace 里**已存在**的最新归档，
# 本地备份由它自己的 03:20 定时器负责。两者相差 50 分钟，足够。
# After= 只在本单元与 backup 被同一次事务启动时才起排序作用，保留无害。
After=network-online.target knowtrace-workflow-backup.service
Wants=network-online.target
# 惰性：没配好就静默跳过，不产生失败记录（否则会天天标 failed，变成"狼来了"）。
# 判据是 age 公钥存在 —— 它只在真正配置异地备份时才创建，是个可靠的"已配置"标志。
ConditionPathExists=/etc/knowtrace/age-recipient.pub

[Service]
Type=oneshot
Environment=OPS_CONF=/etc/knowtrace/ops.conf
UMask=0077
ExecStart=/opt/knowtrace/scripts/linux/offsite-backup.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# 只读脚本 + 只写暂存区与指标文件，再收紧一层
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/tmp /var/backups/knowtrace /opt/knowtrace/runtime/node-exporter
